    "availability_stamp": "max(pdate, fdate) where present, else datadate + 180 calendar days. `funda` has NO `rdq` column and `apdedate` is a period end, not a publication date (measured lag 0 days at q50 AND q90)",
    "buyback_recency_months": 18,
    "buyback_intensity": "prstkc / (csho * prcc_f) from the SAME row",
