  "verdict_meaning": "CONTINUE: at least one graph arm cleared the declared 0.01 bar AND survived BH-FDR \u2014 the graph programme earns its next step. STOP: it did not, and the GNN is not built.",
  "direction_check": {
    "paired": {
      "vs": "peer_laggard",
      "n_months": 131,
      "mean_diff": 0.006723,
      "se": 0.00463,
      "t": 1.452,
