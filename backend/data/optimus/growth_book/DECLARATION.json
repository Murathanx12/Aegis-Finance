 "overlays": {
  "dd": "drawdown control: exposure = clip(1 - |trailing 3m drawdown of the book| / 0.3, 0.25, 1.0), the drawdown lagged one month",
  "tg": "trend gate: exposure 1 when the pinned SPY TR index is at or above its 10-month moving average AT entry, else 0 (the proceeds earn RF)",
  "bsc": "Barroso-Santa-Clara portfolio vol scaling: exposure = target / trailing 6-month annualised vol of the book, target = expanding median of that vol (PIT), capped at 2.0"
 },
