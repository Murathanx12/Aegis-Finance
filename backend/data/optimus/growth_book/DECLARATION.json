  ],
  "development_common_grading_window": [
   "2004-01",
   "2015-12"
  ],
  "why_common_window": "learner/long_panel.py spends 1999-2003 on the five-year walk-forward warm-up, so no model genome has a prediction before 2004-01. Ranking a 1999-start book against a 2004-start book ranks two different decades.",
