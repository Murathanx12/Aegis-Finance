   "2016-01",
   "2024-12"
  ],
  "sealed_policy": "opened ONCE per frozen champion; every opening is appended to SEALED_ERA_OPENINGS.jsonl"
 },
 "cost_rates_bps_per_side": [
  10.0,
  25.0
 ],
