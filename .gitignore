# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ML models (artifacts are local/train-on-deploy, not committed)
*.pkl
*.joblib
*.h5
# crash-model provenance sidecar is paired with its (ignored) .pkl — don't commit
# one without the other, or prod gets a sidecar pointing at an absent binary.
backend/models/crash_model.meta.json

# Node
node_modules/
.next/
out/

# Environment
.env
.env.local
.env.production
# The CI-mimic recipe in HANDOFF_2026-08-24 moves `.env` aside under this name
# while it runs (CI has no .env, and eleven tests once passed locally BECAUSE a
# secrets file existed). It was not ignored: a `git add -A` during that window
# would have committed every key in the repository. Found 2026-08-24.
.env.hidden
.env.*.hidden

