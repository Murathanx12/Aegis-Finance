# never committed. A chunk-6 `git add -A` swept 72 of these into history once.
backend/data/optimus/news_corpus/
backend/data/optimus/analyst_snapshots/
backend/data/optimus/short_interest/**/*.parquet
backend/data/optimus/minute_bars/
backend/data/optimus/book_cadence/
backend/data/optimus/monday_night/

# re-grades of scratch receipts are scratch too (2026-09-12)
backend/data/optimus/night_factory_*/*_smoke_regrade_taq.json

# X2's belief-elasticity feature table (chunk 7, 2026-09-12). The parquet is
# DATA and is regenerated by `python -m scripts.night_x2_elasticity`; the
# MANIFEST.json beside it is TRACKED, so a checkout without the file still
# carries its shape, row count and sha256. The 2026-09-11 CI red was the
# opposite arrangement: tracked artefacts written beside gitignored scratch.
backend/data/optimus/x_lane/*.parquet
