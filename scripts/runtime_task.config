# CH-05 runtime wrapper: the machine-specific paths, in ONE place.
#
# Read by scripts/runtime_task.py, scripts/runtime_task.cmd and scripts/runtime_release.py.
# An environment variable of the same name, when set and non-empty, wins over the value here.
# KEY=VALUE, one per line, no quotes, no trailing spaces. Lines starting with # are comments.
#
# The checkout that holds the live data, the keys file and the interpreters. It is NOT where
# the code runs from after the switch: code runs from C:\Users\mrthn\aegis-runtime\<tag>.
AEGIS_LIVE_ROOT=C:\Users\mrthn\aegis-finance
# The live data directory every writer shares; each production clone junctions
# backend\data\optimus to it.
AEGIS_LIVE_OPTIMUS=C:\Users\mrthn\aegis-finance\backend\data\optimus
# The keys file. Tasks POINT at it (AEGIS_DOTENV_PATH); nothing copies, moves or prints it.
AEGIS_DOTENV_PATH=C:\Users\mrthn\aegis-finance\.env
# The interpreter every task uses, by absolute path (OD-f).
AEGIS_VENV_DIR=C:\Users\mrthn\aegis-finance\.venv
# nn_lab's own interpreter (autogluon); used by `--nn-lab`.
AEGIS_NN_LAB_VENV_DIR=C:\Users\mrthn\aegis-finance\nn_lab\.venv
# Where release clones live: <AEGIS_RUNTIME_ROOT>\<tag>.
AEGIS_RUNTIME_ROOT=C:\Users\mrthn\aegis-runtime
# The publication checkout (AegisDataCatalog / AegisPublicAssetsWeekly run ITS code, by design).
AEGIS_PUBLICATION_ROOT=C:\Users\mrthn\aegis-finance-publication
